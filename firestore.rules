rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isStaff() { return signedIn() && (role() == 'owner' || role() == 'admin'); }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() == 'owner');
      allow create, update, delete: if signedIn() && role() == 'owner';
    }
    match /orders/{id} {
      allow read: if signedIn() && (role() in ['owner','admin','employee']);
      allow create, update, delete: if isStaff();
    }
    match /clients/{id} {
      allow read: if signedIn() && (role() in ['owner','admin','employee']);
      allow create, update, delete: if isStaff();
    }
    match /{document=**} { allow read, write: if false; }
  }
}